{
  "name": "playwright-smart-reporter",
  "version": "4.0.0",
  "description": "An intelligent Playwright HTML reporter with AI-powered failure analysis, flakiness detection, and performance regression alerts",
  "main": "dist/smart-reporter.js",
  "types": "dist/smart-reporter.d.ts",
  "bin": {
    "playwright-smart-reporter-merge-history": "./dist/bin/merge-history.js",
    "playwright-smart-reporter-view-trace": "./dist/bin/view-trace.js",
    "playwright-smart-reporter-serve": "./dist/bin/serve.js",
    "playwright-smart-reporter": "./dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/smart-reporter.d.ts",
      "default": "./dist/smart-reporter.js"
    },
    "./quarantine": {
      "types": "./dist/quarantine/quarantine-helper.d.ts",
      "default": "./dist/quarantine/quarantine-helper.js"
    },
    "./accessibility": {
      "types": "./dist/accessibility/index.d.ts",
      "default": "./dist/accessibility/index.js"
    },
    "./coverage": {
      "types": "./dist/coverage/index.d.ts",
      "default": "./dist/coverage/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs",
    "ui:specimen": "node scripts/build-ui.mjs --specimen",
    "lint:css": "stylelint \"src/ui/**/*.css\"",
    "test:ui": "npm run ui:specimen && playwright test --config=playwright.ui.config.ts",
    "test:ui:docker": "npm run ui:specimen && docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.57.0-noble npx playwright test --config=playwright.ui.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:timeline": "TIMELINE_E2E=1 vitest run example/timeline",
    "test:acceptance": "ACCEPTANCE_E2E=1 vitest run example/acceptance",
    "test:coverage-example": "npm run build && COVERAGE_E2E=1 vitest run src/coverage/coverage-example.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:demo": "playwright test --config=example/playwright.config.ts",
    "test:merge-local": "rm -rf blob-reports && mkdir -p blob-reports/all && PLAYWRIGHT_BLOB_OUTPUT_DIR=blob-reports/run1 playwright test example/parallel/test1.spec.ts --config=example/playwright-blob.config.ts; PLAYWRIGHT_BLOB_OUTPUT_DIR=blob-reports/run2 playwright test example/parallel/test2.spec.ts --config=example/playwright-blob.config.ts; cp blob-reports/run1/*.zip blob-reports/run2/*.zip blob-reports/all/; node ./dist/merge-history.js blob-reports/run1/test-history.json blob-reports/run2/test-history.json -o blob-reports/all/test-history.json; npx playwright merge-reports --reporter=./dist/smart-reporter.js blob-reports/all"
  },
  "keywords": [
    "playwright",
    "reporter",
    "testing",
    "html-reporter",
    "ai",
    "flaky-tests",
    "performance",
    "test-analysis",
    "test-stability",
    "retry-analysis",
    "failure-clustering",
    "trace-viewer",
    "quality-gates",
    "pdf-export",
    "test-quarantine",
    "ci-cd"
  ],
  "author": "Gary Parker",
  "contributors": [
    {
      "name": "Filip Gajic",
      "url": "https://github.com/Morph93"
    },
    {
      "name": "TheAntz",
      "url": "https://github.com/TheAntz"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qa-gary-parker/playwright-smart-reporter.git"
  },
  "homepage": "https://github.com/qa-gary-parker/playwright-smart-reporter#readme",
  "bugs": {
    "url": "https://github.com/qa-gary-parker/playwright-smart-reporter/issues"
  },
  "peerDependencies": {
    "@axe-core/playwright": ">=4.0.0",
    "@playwright/test": ">=1.40.0",
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.49.0",
    "@preact/signals": "^2.11.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.13.8",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^10.1.3",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "stylelint": "^17.16.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@bcoe/v8-coverage": "^1.0.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "adm-zip": "^0.6.1",
    "pdfkit": "^0.16.0",
    "v8-to-istanbul": "^9.3.0"
  }
}
